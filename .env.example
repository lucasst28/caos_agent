# =============================================
# CAOS Agent - Environment Variables
# =============================================
# Copie para .env e ajuste conforme necessário:
#   cp .env.example .env

# === Google Cloud ===
# Para LOCAL: deixe "vivaiot-local", sem credentials
# Para PROD:  coloque o project ID real e o path do service account
GOOGLE_CLOUD_PROJECT=agente-caos
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# === Pub/Sub (só usado quando conectado ao GCP) ===
PUBSUB_SENTINEL_ALERTS_TOPIC=sentinel.alerts
PUBSUB_ORACLE_PREDICTIONS_TOPIC=oracle.predictions
PUBSUB_CAOS_ACTIONS_TOPIC=caos.actions

# === Vertex AI / Google AI Studio ===
# Para LOCAL: use API key do Google AI Studio (aistudio.google.com)
# Para PROD:  pode usar Vertex AI com service account
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=sua-api-key-do-google-ai-studio

# === External APIs ===
# Para LOCAL: use os simuladores (porta 9000)
# Para PROD:  coloque as URLs reais dos agentes
ATLAS_API_URL=http://localhost:9000/atlas
SENTINEL_API_URL=http://localhost:9000/sentinel
ORACLE_API_URL=http://localhost:9000/oracle

# === LangSmith (Tracing) ===
# Para LOCAL: deixe false e vazio
# Para PROD:  coloque sua API key do LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=sua-api-key-do-langsmith
LANGCHAIN_PROJECT=caos-agent

# === Feature Flags ===
ORACLE_BYPASS_ENABLED=true
ORACLE_BYPASS_THRESHOLD=0.8
PUBSUB_ENABLED=false

# === Weights (Fórmula Verdict) ===
WEIGHT_ATLAS=0.6
WEIGHT_ORACLE=0.6
WEIGHT_SEVERITY=0.3

# === Risk Dimension Weights ===
WEIGHT_RISK_PHYSICAL=0.35
WEIGHT_RISK_FINANCIAL=0.25
WEIGHT_RISK_CONTRACTUAL=0.25
WEIGHT_RISK_COMMUNICATION=0.15

# === Rate Limits ===
LLM_DAILY_TOKEN_BUDGET=2000000
LLM_DAILY_COST_BUDGET_USD=50

# === Decision Thresholds ===
THRESHOLD_BLOCKED=0.0
THRESHOLD_ALERT=0.3
THRESHOLD_SUGGEST=0.7

{
  "category": "COMMUNICATION",
  "metadata": {
    "name": "Regras de Comunicação",
    "description": "Brand assurance e stakeholder notification",
    "weight": 0.7
  },
  "rules": [
    {
      "id": "COMM_001",
      "category": "COMMUNICATION",
      "name": "Stakeholder Notification Required",
      "condition": "risk_level in ['HIGH', 'VETO']",
      "action": "ALERT",
      "severity": "MEDIUM",
      "message": "Notificação obrigatória para stakeholders."
    },
    {
      "id": "COMM_002",
      "category": "COMMUNICATION",
      "name": "Cliente VIP",
      "condition": "atlas_context.contract_tier == 'PREMIUM'",
      "action": "ALERT",
      "severity": "LOW",
      "message": "Cliente PREMIUM. Priorizar comunicação."
    },
    {
      "id": "COMM_003",
      "category": "COMMUNICATION",
      "name": "Mensagem Muito Longa",
      "condition": "len(proposed_action.justification) > 500",
      "action": "LOG",
      "severity": "LOW",
      "message": "Justificativa muito longa. Considerar resumir."
    },
    {
      "id": "COMM_004",
      "category": "COMMUNICATION",
      "name": "Canal de Notificação Indisponível",
      "condition": "notification_channel_status == 'down'",
      "action": "REQUIRE_APPROVAL",
      "severity": "HIGH",
      "message": "Canal de notificação indisponível."
    },
    {
      "id": "COMM_005",
      "category": "COMMUNICATION",
      "name": "Múltiplas Notificações",
      "condition": "notifications_last_hour > 10",
      "action": "DEGRADE",
      "severity": "LOW",
      "message": "Muitas notificações recentes. Agregando."
    }
  ]
}